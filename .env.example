# ==============================================================================
# Stamply Environment Configuration
# ==============================================================================

# Private key for deploying the smart contract on Botchain Testnet
# (DO NOT commit your actual private key or prefix with anything public)
PRIVATE_KEY=your_private_key_without_or_with_0x_here

# Deployed Stamply contract address on Botchain Testnet (Chain ID: 968)
# Once deployed, paste the address here for the frontend to connect to:
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Botchain Testnet RPC URL
NEXT_PUBLIC_RPC_URL=https://rpc.bohr.life

# Botchain Explorer URL
NEXT_PUBLIC_EXPLORER_URL=https://scan.bohr.life
